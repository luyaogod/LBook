{
  "name": "lbook",
  "productName": "LBook",
  "version": "0.0.1",
  "private": true,
  "description": "LBook - a desktop library for reading and annotating PaddleOCR-scanned books",
  "author": "luyao",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build.mjs",
    "build:renderer": "tsc -b tsconfig.renderer.json && vite build",
    "check:docs": "node scripts/check-docs.mjs",
    "check:edit": "node scripts/run.mjs check-edit",
    "check:editor": "npm run build:renderer && vite build --config vite.spike.config.ts && node scripts/run.mjs --electron check-editor",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:inspect": "node scripts/run.mjs check-inspect",
    "check:locate": "node scripts/run.mjs check-locate",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "lint": "oxlint",
    "pack": "npm run build && electron-builder --win --publish never",
    "probe:edit": "node scripts/run.mjs edit-probe",
    "probe:perf": "node scripts/run.mjs perf-probe",
    "probe:tencent": "node scripts/run.mjs tencent-probe",
    "release": "npm run build && electron-builder --win --publish always",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.renderer.json tsconfig.main.json tsconfig.node.json"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "i18next": "^26.4.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.23.0",
    "oxlint": "^1.71.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.16",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.3"
  }
}
