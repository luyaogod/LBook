{
  "name": "lbook",
  "productName": "LBook",
  "version": "0.0.1",
  "private": true,
  "description": "LBook - a desktop library for reading and annotating PaddleOCR-scanned books",
  "author": "luyao",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build:main": "node scripts/build.mjs",
    "build:renderer": "tsc -b tsconfig.renderer.json && vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -b tsconfig.renderer.json tsconfig.main.json tsconfig.node.json",
    "start": "electron .",
    "seed:library": "node scripts/run.mjs seed-library",
    "migrate:legacy": "node scripts/run.mjs migrate-legacy",
    "verify:package": "node scripts/run.mjs verify-package",
    "probe:tencent": "node scripts/run.mjs tencent-probe",
    "pack": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "lint": "oxlint",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe:perf": "node scripts/run.mjs perf-probe"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "i18next": "^26.4.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.23.0",
    "oxlint": "^1.71.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.16",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.3"
  }
}
